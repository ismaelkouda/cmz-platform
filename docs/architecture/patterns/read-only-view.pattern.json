    },
    "dashboard.module.shell": {
      "module": "dashboard",
      "description": "Routes, endpoints, composition root"
    }
  },
  "grafana_multi_section_core_files_legacy": [
    "domain/entities/{SECTION}/{SECTION}.entity.ts",
    "domain/repositories/{SECTION}/{SECTION}.repository.ts",
    "application/use-cases/{SECTION}/{SECTION}.use-case.ts",
    "application/services/{SECTION}/{SECTION}.facade.ts",
    "application/queries/{SECTION}/{SECTION}.query.ts",
    "application/queries-handlers/{SECTION}/{SECTION}.handler.ts",
    "application/queries-mappers/{SECTION}/{SECTION}.mapper.ts",
