    "consolidated_domain_data": [
      "libs/{MODULE}/domain/src/lib/entities/grafana-dashboard.entity.ts",
      "libs/{MODULE}/domain/src/lib/enums/{module}-section.enum.ts",
      "libs/{MODULE}/domain/src/lib/repositories/{module}.repository.ts",
      "libs/{MODULE}/data/src/lib/dtos/{module}-variables-response.dto.ts",
      "libs/{MODULE}/data/src/lib/endpoints/{module}.endpoints.ts",
      "libs/{MODULE}/data/src/lib/mappers/grafana-dashboard.mapper.ts",
      "libs/{MODULE}/data/src/lib/sources/{module}.api.ts",
      "libs/{MODULE}/data/src/lib/repositories/{module}.repository.impl.ts"
    ],
    "per_section_application": [
      "libs/{MODULE}/application/src/lib/use-cases/{module}.use-case.ts",
      "libs/{MODULE}/application/src/lib/facades/{section-kebab}.facade.ts"
    ],
    "per_section_ui": [
      "libs/{MODULE}/ui/src/lib/features/{section-kebab}-page.component.ts"
    ],
    "module_shell": [
      "libs/{MODULE}/ui/src/lib/features/{module}.routes.ts",
      "apps/backoffice-angular/src/app/providers/{module}.providers.ts"
    ],
    "shared_kernel": [
      "libs/shared/application/src/lib/facades/resource.facade.ts",
      "libs/shared/ui/src/lib/components/grafana-embed/grafana-embed.component.ts"
    ]
  },
  "grafana_single_view_core_files_nx": [
    "libs/{MODULE}/domain/src/lib/entities/map.entity.ts",
    "libs/{MODULE}/domain/src/lib/repositories/{module}.repository.ts",
    "libs/{MODULE}/data/src/lib/dtos/map-response.dto.ts",
    "libs/{MODULE}/data/src/lib/mappers/map.mapper.ts",
    "libs/{MODULE}/data/src/lib/sources/map.api.ts",
    "libs/{MODULE}/data/src/lib/repositories/{module}.repository.impl.ts",
    "libs/{MODULE}/application/src/lib/use-cases/map.use-case.ts",
    "libs/{MODULE}/application/src/lib/facades/map.facade.ts",
    "libs/{MODULE}/ui/src/lib/features/map-page.component.ts"
  ],
  "nx_mapping": {
    "module_placeholder": "{MODULE}",
    "section_placeholder": "{SECTION}",
    "section_kebab": "{section-kebab}",
    "naming": {
      "entity_class_multi": "GrafanaDashboardEntity",
      "entity_class_single": "MapEntity",
      "section_enum": "{ModulePascal}Section",
      "repository_port": "{ModulePascal}Repository",
      "repository_impl": "{ModulePascal}RepositoryImpl",
      "use_case_class": "{ModulePascal}UseCase",
      "facade_class": "{SectionPascal}Facade",
      "page_component": "{SectionPascal}PageComponent",
      "section_field_map": "{MODULE}_SECTION_FIELD"
    },
    "layer_map": {
      "domain": "libs/{MODULE}/domain/src/lib",
      "data": "libs/{MODULE}/data/src/lib",
      "application": "libs/{MODULE}/application/src/lib",
      "ui": "libs/{MODULE}/ui/src/lib",
      "di": "apps/backoffice-angular/src/app/providers"
    },
    "legacy_layers_dropped_in_nx": [
      "application/queries/{SECTION}/{SECTION}.query.ts",
      "application/queries-handlers/{SECTION}/{SECTION}.handler.ts",
      "application/queries-mappers/{SECTION}/{SECTION}.mapper.ts",
      "application/queries-bus/{SECTION}/{SECTION}.bus.ts"
    ],
    "legacy_layers_dropped_rationale": "Use-case direct + ResourceFacade remplace CQRS ceremony pour lectures query-only en cible Nx"
  },
  "forbidden_in_nx": [
    "commands",
    "mutations",
    "CollectionFacade runAction",
    "PaginatedResourceFacade",
    "filter-store",
    "vm-props",
    "vm-presenter",
    "cmz-table",
    "cmz-filter",
    "__action",
    "__actionDropdown"
  ],
  "required_shared": {
    "ResourceFacade": "libs/shared/application/src/lib/facades/resource.facade.ts",
    "GrafanaEmbedComponent": "libs/shared/ui/src/lib/components/grafana-embed/grafana-embed.component.ts",
    "FetchOptions": "@cmz/shared-domain"
  },
  "consolidation_rule": {
    "trigger": "N pages legacy avec même forme (1 champ grafanaLink, même endpoint variables)",
    "domain": "1 GrafanaDashboardEntity + 1 {Module}Repository.execute(section, options?)",
    "data": "1 DTO variables (tous champs wire) + 1 mapper paramétré {MODULE}_SECTION_FIELD",
    "application_ui": "N façades distinctes (1 singleton par page, section hardcodée dans stream())"
  },
  "differences_vs_crud_entity": {
    "pas_de_liste_paginee": "Pas de FilterEntity, PageResult, ni table liste",
    "pas_de_mutations": "Aucun create/update/delete/enable/disable",
    "pas_de_vm_props": "Page lie directement facade.value() au composant embed"
  },
  "differences_vs_workflow_action": {
    "pas_de_workflow": "Pas de take/treat/approve, pas de details dialog, pas d'export Excel liste",
    "pas_de_section_volet": "Section = clé de pluck DTO, pas volet queues/tasks/all"
  },
  "differences_vs_action_request": {
    "lecture_seule": "execute/getMap retourne Observable<Entity> — pas de Command DTO ni handler mutation"
  },
  "design_decisions_v0": {
    "contexte": "Première formalisation read-only-view — monorepo cmz-platform, modules monitoring + reporting livrés.",
    "reference_module": "monitoring choisi car premier livré avec décision de consolidation documentée (module-monitoring.md)",
    "corpus_next": "Émission corpus monitoring.pairs.jsonl + reporting.pairs.jsonl — tâche planifiée post-v0",
    "interactive_map_scope": "Grafana + SIG v1 clôturés IR ; parité legacy SIG (clusters, tuiles, filtres) P2 — A-2026-08-01-02",
    "oracle_minimum": [
      "bunx nx run-many -t build --projects=tag:scope:{module}",
      "bunx eslint libs/{module} --max-warnings=0",
      "ngc --strictTemplates"
    ]
  },
  "core_files_count_estimate": {
    "grafana_multi_section_consolidated_nx": 8,
    "grafana_multi_section_per_page_nx": 2,
    "grafana_multi_section_module_shell": 2,
    "monitoring_pages": 4,
    "reporting_pages": 4,
    "note": "Comptes indicatifs — source de vérité = impl libs/monitoring et libs/reporting"
  }
}
