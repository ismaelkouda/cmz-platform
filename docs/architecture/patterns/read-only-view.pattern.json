{
  "pattern": "read-only-view",
  "version": 0,
  "lineage": "Enterprise OOP (Angular + DDD) — famille lecture seule : vues analytiques query-only, embeds Grafana, cartes SIG (optionnel)",
  "description": "Module ou page en lecture seule sans mutation métier. Pipeline minimal : entité lien (Grafana ou carte) + section paramétrée + use-case defer + ResourceFacade par page + composant page mince. Ni crud-entity (pas de liste paginée CRUD) ni workflow-action (pas de take/treat). Consolidation domaine/data : N pages legacy identiques → 1 entité, 1 DTO variables, 1 repository paramétré par section, 1 mapper pluck ; application/UI restent N façades + N pages.",
  "validated_on": ["monitoring", "reporting", "dashboard", "interactive-map"],
  "reference_module": "monitoring",
  "reference_implementation": {
    "legacy_path": "src/presentation/pages/monitoring",
    "nx_path": "libs/monitoring",
    "description": "4 embeds Grafana — consolidation 4× vertical → 1 stack domain/data"
  },
  "second_validation": {
    "module": "reporting",
    "legacy_path": "src/presentation/pages/reporting",
    "nx_path": "libs/reporting",
    "pattern_schema_unchanged": true,
    "validated_at": "2026-08-01",
    "notes": "Réplication stricte du schéma monitoring — 4 sections, même endpoint variables"
  },
  "third_validation": {
    "module": "dashboard",
    "legacy_path": "src/presentation/pages/dashboard",
    "nx_path": "libs/dashboard",
    "subgraph": "aggregated_stats_view",
    "validated_at": "2026-08-01",
    "notes": "Objet agrégé unique + filtre période — exceptions filter-store / vm-presenter autorisées"
  },
  "fourth_validation": {
    "module": "interactive-map",
    "legacy_path": "src/presentation/pages/interactive-map",
    "nx_path": "libs/interactive-map",
    "subgraphs": ["grafana_single_view", "gis_map_view"],
    "validated_at": "2026-08-01",
    "status": "closed_with_documented_gaps",
    "notes": "Visualization ✅ ; SIG v1 (OL lazy + report/all) ✅ — clusters/tiles/geojson P2 (A-2026-08-01-02)"
  },
  "subgraphs": {
    "grafana_multi_section": {
      "description": "N pages Grafana partageant GET variables — 1 stack consolidé domain/data",
      "placeholder": "{SECTION}",
      "modules": ["monitoring", "reporting"],
      "shared_endpoint": "SETTINGS_API_URL/variables",
      "entity_shape": "GrafanaDashboardEntity(grafanaLink: string)"
    },
    "grafana_single_view": {
      "description": "1 page Grafana — repository getMap() sans enum section",
      "modules": ["interactive-map"],
      "route": "visualization",
      "entity_shape": "MapEntity(grafanaLink: string)"
    },
    "gis_map_view": {
      "description": "Carte SIG dynamique (OpenLayers) — v1 marqueurs report/all ; parité legacy P2",
      "modules": ["interactive-map"],
      "route": "interactive",
      "status": "v1-implemented",
      "current_nx": "InteractiveMapSigFacade + InteractiveMapOlViewComponent — marqueurs GET report/all ; clusters/tiles P2"
    },
    "aggregated_stats_view": {
      "description": "Objet agrégé unique (statistiques) + filtre période — ResourceFacade, sans embed Grafana",
      "modules": ["dashboard"],
      "route": "dashboard",
      "entity_shape": "DashboardEntity(props: DashboardProps)",
      "exceptions_to_forbidden": ["filter-store", "vm-presenter"],
      "notes": "Cartes statistiques — GET report/statistics ; pas de consolidation multi-section"
    }
  },
  "chains": {
    "monitoring.node.view": {
      "module": "monitoring",
      "section": "node",
      "subgraph": "grafana_multi_section",
      "description": "État traitement — embed Grafana"
    },
    "monitoring.services.view": {
      "module": "monitoring",
      "section": "services",
      "subgraph": "grafana_multi_section",
      "description": "État services — embed Grafana"
