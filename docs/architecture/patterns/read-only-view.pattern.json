    "monitoring.resources.view": {
      "module": "monitoring",
      "section": "resources",
      "subgraph": "grafana_multi_section",
      "description": "État ressources — embed Grafana"
    },
    "monitoring.jobs.view": {
      "module": "monitoring",
      "section": "jobs",
      "subgraph": "grafana_multi_section",
      "description": "Impact jobs — embed Grafana"
    },
    "monitoring.module.shell": {
      "module": "monitoring",
      "description": "Routes, endpoints, composition root"
    },
    "reporting.report.view": {
      "module": "reporting",
      "section": "report",
