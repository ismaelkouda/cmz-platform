# Les clients Git graphiques (VS Code, Sourcetree, GitKraken…) ne chargent pas
# le profil du shell : bun peut être absent du PATH. On rétablit son
# emplacement d'installation par défaut, sans quoi le hook échoue sur un
# « bun: not found » incompréhensible. Voir ADR-0006.
export PATH="$HOME/.bun/bin:$HOME/.npm-global/bin:$PATH"

bun run check:versions
# T4-5 — secrets sur les commits de la branche (origin/main..HEAD)
bun run check:secrets -- --pre-push
