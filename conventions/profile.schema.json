{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cmz.local/schemas/conventions/profile.schema.json",
  "title": "CMZ Convention Profile",
  "description": "Un profil de convention par (plateforme, version majeure). Décrit les choix de code natifs de CETTE plateforme au moment de la génération. Il ne contient jamais d'abstraction cross-platform : le renderer / LLM d'une cible ne lit que son propre profil. Voir conventions/README.md et ADR-0010.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "platform",
    "platform_version",
    "description",
    "source_of_truth",
    "conventions",
    "validation"
  ],
  "properties": {
    "$schema": { "type": "string", "minLength": 1 },
    "platform": { "enum": ["angular", "react", "kotlin", "swift"] },
    "platform_version": {
      "type": "string",
      "pattern": "^[0-9]+(?:\\.[0-9]+){0,2}$"
    },
    "description": { "type": "string", "minLength": 1 },
    "source_of_truth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origin", "verified_for"],
      "properties": {
        "origin": { "type": "string", "minLength": 1 },
        "verified_for": { "type": "string", "minLength": 1 },
        "note": { "type": "string", "minLength": 1 }
      }
    },
    "conventions": {
      "type": "object",
      "required": ["i18n", "async_state"],
      "properties": {
        "i18n": { "$ref": "#/$defs/i18n" },
        "async_state": { "$ref": "#/$defs/asyncState" }
      }
    },
    "validation": {
      "type": "object",
      "required": ["catalogVersionMustMatch"],
      "properties": {
        "catalogVersionMustMatch": { "type": "string", "minLength": 1 },
        "note": { "type": "string", "minLength": 1 }
      }
    }
  },
  "$defs": {
    "i18n": {
      "type": "object",
      "additionalProperties": false,
      "required": ["library", "package", "forbid"],
      "properties": {
        "library": { "type": "string", "minLength": 1 },
        "package": { "type": "string", "minLength": 1 },
        "template_api": { "type": "string", "minLength": 1 },
        "runtime_api": { "type": "string", "minLength": 1 },
        "provider": { "type": "string", "minLength": 1 },
        "adr": { "type": "string", "pattern": "^ADR-[0-9]{4}$" },
        "forbid": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "asyncState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["server_state", "forbid"],
      "properties": {
        "server_state": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "observable_interop": { "type": "string", "minLength": 1 },
        "fallback": { "type": "string", "minLength": 1 },
        "forbid": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
