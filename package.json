{
  "name": "@cmz/source",
  "version": "0.0.0",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "preinstall": "node tools/check-engines.mjs",
    "prepare": "husky",
    "check:engines": "node tools/check-engines.mjs",
    "check:versions": "node tools/check-catalog-usage.mjs",
    "check:weight": "node tools/check-file-weight.mjs",
    "check:all": "bun run check:engines && bun run check:versions && bun run check:weight",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {},
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@nx/js": "23.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.1.0",
    "nx": "23.1.0",
    "prettier": "^3.9.6"
  },
  "workspaces": {
    "packages": [
      "apps/*",
      "libs/*"
    ],
    "catalog": {
      "@angular/animations": "22.0.7",
      "@angular/cdk": "22.0.5",
      "@angular/common": "22.0.7",
      "@angular/compiler": "22.0.7",
      "@angular/core": "22.0.7",
      "@angular/forms": "22.0.7",
      "@angular/localize": "22.0.7",
      "@angular/platform-browser": "22.0.7",
      "@angular/router": "22.0.7",
      "@angular/service-worker": "22.0.7",
      "rxjs": "7.8.2",
      "tslib": "2.8.1",
      "zone.js": "0.16.2"
    },
    "catalogs": {
      "tooling": {
        "@angular/build": "22.0.7",
        "@angular/cli": "22.0.7",
        "@angular/compiler-cli": "22.0.7",
        "typescript": "6.0.3"
      }
    }
  },
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0",
    "bun": ">=1.3.0"
  }
}
