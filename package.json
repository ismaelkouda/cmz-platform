{
  "name": "@cmz/source",
  "version": "0.0.0",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "preinstall": "node tools/check-engines.mjs",
    "prepare": "husky",
    "check:engines": "node tools/check-engines.mjs",
    "check:versions": "node tools/check-catalog-usage.mjs",
    "check:weight": "node tools/check-file-weight.mjs",
    "check:names": "node tools/check-project-names.mjs",
    "check:dead-code": "bunx knip",
    "check:tier2": "bunx ngc -p apps/backoffice-angular/tsconfig.app.json --noEmit && bunx nx run backoffice-angular:build:development",
    "check:all": "bun run check:engines && bun run check:versions && bun run check:weight && bun run check:names",
    "generate:status": "node tools/generate-status.mjs",
    "corpus:processing": "node tools/corpus/emit-pairs.mjs processing --verify --tranche A",
    "corpus:processing:full": "node tools/corpus/emit-pairs.mjs processing --verify",
    "corpus:processing:export": "node tools/corpus/emit-pairs.mjs processing --verify --chain processing.export.list",
    "corpus:processing:emit": "node tools/corpus/emit-pairs.mjs processing",
    "corpus:processing:report": "node tools/corpus/emit-pairs.mjs processing --report --dry-run",
    "corpus:requests": "node tools/corpus/emit-pairs.mjs requests --verify --tranche A",
    "corpus:requests:full": "node tools/corpus/emit-pairs.mjs requests --verify",
    "corpus:requests:report": "node tools/corpus/emit-pairs.mjs requests --report --dry-run",
    "corpus:finalization": "node tools/corpus/emit-pairs.mjs finalization --verify",
    "corpus:finalization:report": "node tools/corpus/emit-pairs.mjs finalization --report --dry-run",
    "corpus:report-states": "node tools/corpus/emit-pairs.mjs report-states --verify",
    "corpus:report-states:full": "node tools/corpus/emit-pairs.mjs report-states --verify",
    "corpus:report-states:export": "node tools/corpus/emit-pairs.mjs report-states --verify --chain report-states.export.list",
    "corpus:monitoring": "node tools/corpus/emit-pairs.mjs monitoring --verify",
    "corpus:monitoring:report": "node tools/corpus/emit-pairs.mjs monitoring --report --dry-run",
    "corpus:reporting": "node tools/corpus/emit-pairs.mjs reporting --verify",
    "corpus:reporting:report": "node tools/corpus/emit-pairs.mjs reporting --report --dry-run",
    "corpus:sync-pattern": "node tools/corpus/sync-workflow-action-pattern.mjs",
    "corpus:ci": "CORPUS_ORACLE_ONLY=1 node tools/corpus/emit-pairs.mjs processing --verify --oracle-only && CORPUS_ORACLE_ONLY=1 node tools/corpus/emit-pairs.mjs requests --verify --oracle-only && CORPUS_ORACLE_ONLY=1 node tools/corpus/emit-pairs.mjs finalization --verify --oracle-only && CORPUS_ORACLE_ONLY=1 node tools/corpus/emit-pairs.mjs report-states --verify --oracle-only && CORPUS_ORACLE_ONLY=1 node tools/corpus/emit-pairs.mjs monitoring --verify --oracle-only && CORPUS_ORACLE_ONLY=1 node tools/corpus/emit-pairs.mjs reporting --verify --oracle-only",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "mock": "node tools/mock-server.mjs"
  },
  "dependencies": {
    "@angular/common": "catalog:",
