      "@angular/platform-browser": "22.0.7",
      "@angular/router": "22.0.7",
      "@angular/service-worker": "22.0.7",
      "rxjs": "7.8.2",
      "tslib": "2.8.1",
      "zone.js": "0.16.2",
      "i18next": "26.3.6",
      "date-fns": "4.4.0",
      "exceljs": "4.4.0",
      "tailwindcss": "4.1.13",
      "@tailwindcss/postcss": "4.1.13",
      "postcss": "8.5.6"
    },
    "catalogs": {
      "tooling": {
        "@angular-devkit/core": "22.0.7",
        "@angular-devkit/schematics": "22.0.7",
        "@angular/build": "22.0.7",
        "@angular/cli": "22.0.7",
        "@angular/compiler-cli": "22.0.7",
        "@angular/language-service": "22.0.7",
        "@schematics/angular": "22.0.7",
        "typescript": "6.0.3"
      }
    }
  },
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0",
    "bun": ">=1.3.0"
  }
