    "@eslint/js": "^9.8.0",
    "@nx/angular": "23.1.0",
    "@nx/eslint": "23.1.0",
    "@nx/eslint-plugin": "23.1.0",
    "@nx/js": "23.1.0",
    "@nx/web": "23.1.0",
    "@swc/helpers": "~0.5.18",
    "@typescript-eslint/utils": "^8.58.0",
    "angular-eslint": "^22.0.0",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "husky": "^9.1.7",
    "jsdom": "^27.1.0",
    "lint-staged": "^17.1.0",
    "nx": "23.1.0",
    "prettier": "^3.9.6",
    "typescript": "catalog:tooling",
    "typescript-eslint": "^8.58.0",
    "vitest": "^4.0.8",
    "tailwindcss": "catalog:",
