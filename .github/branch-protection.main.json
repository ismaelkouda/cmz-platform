{
  "$comment": "Source de vérité — appliquée par `bun run protect:main` (audit G-2 / P1-13). Les contextes = `jobs.*.name` de `.github/workflows/ci.yml` (jobs bloquants uniquement ; knip / duplicates restent non bloquants).",
  "required_status_checks": {
    "strict": true,
    "contexts": [
      "Garde-fous socle",
      "Docs freshness",
      "Oracle — lint + build + ngc + test",
      "Corpus SEOS — structural-only"
    ]
  },
  "enforce_admins": true,
  "required_pull_request_reviews": {
    "dismiss_stale_reviews": true,
    "require_code_owner_reviews": true,
    "required_approving_review_count": 1,
    "require_last_push_approval": false
  },
  "restrictions": null,
  "required_linear_history": false,
  "allow_force_pushes": false,
  "allow_deletions": false,
  "block_creations": false,
  "required_conversation_resolution": true,
  "lock_branch": false,
  "allow_fork_syncing": false
}
