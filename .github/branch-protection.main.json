      "Library candidate isolation (linux-docker)",
      "Library candidate isolation (macos-sandbox)",
      "Library integration (create-app → Material → Tailwind)",
      "Secret scan (gitleaks)",
      "Docs freshness",
      "Oracle — lint + build + ngc + test",
      "E2E smoke — login (Playwright)",
      "Corpus SEOS — structural-only",
      "Dead-code (knip)",
      "Dependency audit (bun audit)",
      "i18n keys (check:i18n)",
      "Third-party licenses (license-checker)",
      "Duplicate files (MD5)"
    ]
  },
  "enforce_admins": true,
  "required_pull_request_reviews": {
    "dismiss_stale_reviews": true,
    "require_code_owner_reviews": true,
