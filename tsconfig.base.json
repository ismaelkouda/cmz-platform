{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2020", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "strict": false,
    "paths": {
      "@cmz/shared-data": ["./libs/shared/data/src/index.ts"],
      "@cmz/shared-domain": ["./libs/shared/domain/src/index.ts"],
      "@cmz/shared-constants": ["./libs/shared/constants/src/index.ts"],
      "@cmz/shared-application": ["./libs/shared/application/src/index.ts"],
      "@cmz/shared-infra": ["./libs/shared/infra/src/index.ts"],
      "@cmz/shared-ui": ["./libs/shared/ui/src/index.ts"],
      "@cmz/core": ["./libs/core/src/index.ts"],
      "@cmz/administrative-infrastructure-domain": [
        "./libs/administrative-infrastructure/domain/src/index.ts"
      ],
      "@cmz/administrative-infrastructure-data": [
        "./libs/administrative-infrastructure/data/src/index.ts"
      ],
      "@cmz/administrative-infrastructure-application": [
        "./libs/administrative-infrastructure/application/src/index.ts"
      ],
      "@cmz/administrative-infrastructure-ui": [
        "./libs/administrative-infrastructure/ui/src/index.ts"
      ]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
