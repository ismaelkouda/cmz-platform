{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "ignore": [
    "**/*.spec.ts",
    "!apps/backoffice-angular/e2e/*.spec.ts",
    "!apps/users-management-proof/e2e/*.spec.ts",
    "!apps/users-management-react-proof/src/**/*.spec.ts",
    "!apps/workspace-react-proof/e2e/*.spec.ts"
  ],
  "ignoreExportsUsedInFile": true,
  "workspaces": {
    ".": {
      "entry": [
        "apps/backoffice-angular/src/main.ts",
        "apps/users-management-proof/src/main.ts",
        "apps/workspace-react-proof/src/main.tsx",
        "apps/workspace-react-proof/src/**/*.spec.tsx",
        "apps/workspace-react-proof/vite.config.mts",
        "apps/users-management-react-proof/src/main.tsx",
        "apps/users-management-react-proof/src/**/*.spec.{ts,tsx}",
        "apps/users-management-react-proof/src/app/generated/page_6666666666666666/reactjs/src/index.ts",
        "apps/users-management-react-proof/vite.config.mts",
        "apps/backoffice-angular/public/env.js",
        "apps/backoffice-angular/src/tailwind.css",
        "tools/**/*.{mjs,ts,tsx}",
        "apps/backoffice-angular/src/app/providers/permission.guard.ts",
        "apps/backoffice-angular/src/app/testing/axe-a11y.util.ts",
        "apps/backoffice-angular/src/app/testing/a11y-testbed.harness.ts",
        "apps/backoffice-angular/e2e/*.spec.ts",
        "apps/users-management-proof/e2e/*.spec.ts",
        "apps/workspace-react-proof/e2e/*.spec.ts"
      ],
      "project": [
        "apps/backoffice-angular/**/*.{ts,tsx,css,mjs}",
        "apps/users-management-proof/**/*.{ts,tsx,css,mjs}",
        "apps/workspace-react-proof/**/*.{ts,tsx,css,scss,mjs}",
        "apps/users-management-react-proof/**/*.{ts,tsx,css,scss,mjs}",
        "apps/backoffice-angular/public/**/*.js",
        "tools/**/*.{mjs,ts,tsx}"
      ]
    },
    "libs/*": {
      "project": ["src/**/*.ts"]
    },
    "libs/*/*": {
      "project": ["src/**/*.ts"]
    }
  },
  "eslint": {
    "config": ["eslint.config.mjs", "apps/**/eslint.config.mjs"]
  },
  "ignoreDependencies": [
    "@angular/cli",
    "@angular/language-service",
    "@eslint/js",
    "@nx/js",
    "@swc/helpers",
    "@typescript-eslint/utils",
    "angular-eslint",
    "typescript-eslint",
    "@tailwindcss/postcss",
    "@angular/forms",
    "date-fns",
    "exceljs",
    "i18next",
    "ol",
    "eslint-plugin-import",
    "eslint-plugin-jsx-a11y",
    "eslint-plugin-react"
  ],
  "ignoreBinaries": ["semgrep"],
  "rules": {
    "catalog": "off",
    "types": "off"
  }
}
