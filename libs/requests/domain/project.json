{
  "name": "@cmz/requests-domain",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/requests/domain/src",
  "projectType": "library",
  "tags": ["scope:requests", "type:domain"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit --project libs/requests/domain/tsconfig.json",
        "cwd": "{workspaceRoot}"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bunx vitest run --config libs/requests/domain/vite.config.ts",
        "cwd": "{workspaceRoot}"
      }
    }
  }
}
