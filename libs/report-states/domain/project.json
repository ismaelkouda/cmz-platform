{
  "name": "@cmz/report-states-domain",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/report-states/domain/src",
  "projectType": "library",
  "tags": ["scope:report-states", "type:domain"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit --project libs/report-states/domain/tsconfig.json",
        "cwd": "{workspaceRoot}"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bunx vitest run --config libs/report-states/domain/vite.config.ts",
        "cwd": "{workspaceRoot}"
      }
    }
  }
}
