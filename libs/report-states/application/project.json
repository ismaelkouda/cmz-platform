{
  "name": "@cmz/report-states-application",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/report-states/application/src",
  "projectType": "library",
  "tags": ["scope:report-states", "type:application"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit --project libs/report-states/application/tsconfig.json",
        "cwd": "{workspaceRoot}"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bunx vitest run --config tools/vitest-lib.config.ts",
        "cwd": "{workspaceRoot}",
        "env": {
          "CMZ_VITEST_LIB_ROOT": "libs/report-states/application"
        }
      }
    }
  }
}
