{
  "name": "@cmz/reporting-ui",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/reporting/ui/src",
  "projectType": "library",
  "tags": ["scope:reporting", "type:ui"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit --project libs/reporting/ui/tsconfig.json",
        "cwd": "{workspaceRoot}"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bunx vitest run --config tools/vitest-lib.config.ts",
        "cwd": "{workspaceRoot}",
        "env": {
          "CMZ_VITEST_LIB_ROOT": "libs/reporting/ui"
        }
      }
    }
  }
}
