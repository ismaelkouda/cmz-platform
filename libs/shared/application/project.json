{
  "name": "@cmz/shared-application",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/shared/application/src",
  "projectType": "library",
  "tags": ["scope:shared", "type:application"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit --project libs/shared/application/tsconfig.json",
        "cwd": "{workspaceRoot}"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "bunx vitest run --config tools/vitest-lib.config.ts",
          "bunx vitest run --config tools/vitest-lib-rxresource.config.ts"
        ],
        "cwd": "{workspaceRoot}",
        "env": {
          "CMZ_VITEST_LIB_ROOT": "libs/shared/application"
        }
      }
    }
  }
}
