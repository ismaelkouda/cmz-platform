{
  "name": "@cmz/interactive-map-ui",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/interactive-map/ui/src",
  "projectType": "library",
  "tags": [
    "scope:interactive-map",
    "type:ui"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit --project libs/interactive-map/ui/tsconfig.json",
        "cwd": "{workspaceRoot}"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bunx vitest run --config tools/vitest-lib.config.ts",
        "cwd": "{workspaceRoot}",
        "env": {
          "CMZ_VITEST_LIB_ROOT": "libs/interactive-map/ui"
        }
      }
    }
  }
}
