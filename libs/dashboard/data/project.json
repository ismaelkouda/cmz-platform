{
  "name": "@cmz/dashboard-data",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/dashboard/data/src",
  "projectType": "library",
  "tags": [
    "scope:dashboard",
    "type:data"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit --project libs/dashboard/data/tsconfig.json",
        "cwd": "{workspaceRoot}"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bunx vitest run --config tools/vitest-lib.config.ts",
        "cwd": "{workspaceRoot}",
        "env": {
          "CMZ_VITEST_LIB_ROOT": "libs/dashboard/data"
        }
      }
    }
  }
}
