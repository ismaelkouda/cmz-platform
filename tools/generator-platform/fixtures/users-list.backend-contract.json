  "operations": [
    {
      "id": "settings-security.list-users",
      "service_id": "settings-api",
      "status": "implemented",
      "description": "Loads one filtered page of users.",
      "method": "GET",
      "path": "/settings-and-security/users",
      "access": {
        "mode": "authenticated",
        "security_scheme_ids": ["backoffice-session-bearer"],
        "permissions": []
      },
      "request": {
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "description": "One-based page requested by the users facade.",
            "required": true,
            "type": { "kind": "primitive", "name": "integer" },
            "constraints": { "minimum": 1 },
            "evidence": [
              { "source_id": "users-api", "locator": "?page=${page}" }
            ]
          },
          {
            "name": "search",
            "in": "query",
            "description": "Combined first-name, last-name or email search.",
            "required": false,
            "type": { "kind": "primitive", "name": "string" },
            "constraints": { "min_length": 1 },
            "evidence": [
              {
                "source_id": "users-filter-dto",
                "locator": "UsersFilterApiDto.search"
              }
            ]
          },
          {
            "name": "profile",
            "in": "query",
            "description": "Profile display-name filter.",
            "required": false,
            "type": { "kind": "primitive", "name": "string" },
            "constraints": { "min_length": 1 },
            "evidence": [
              {
                "source_id": "users-filter-dto",
                "locator": "UsersFilterApiDto.profile"
              }
            ]
          },
          {
            "name": "role",
            "in": "query",
            "description": "Mapped wire role filter.",
            "required": false,
            "type": { "kind": "primitive", "name": "string" },
            "constraints": { "pattern": "^(supervisor|team-leader|agent)$" },
            "evidence": [
              {
                "source_id": "users-filter-mapper",
                "locator": "rolesMapper.mapToDto"
              }
            ]
          },
          {
            "name": "is_active",
            "in": "query",
            "description": "Boolean active-status filter.",
            "required": false,
            "type": { "kind": "primitive", "name": "boolean" },
            "evidence": [
              {
                "source_id": "users-filter-mapper",
                "locator": "params.is_active"
              }
            ]
          }
        ]
      },
      "responses": [
        {
          "status": 200,
          "outcome": "success",
          "description": "Filtered users page available.",
          "body": {
            "media_type": "application/json",
            "model_id": "users-list-page-wire",
            "envelope": {
              "kind": "object",
              "data_field": "data",
              "error_field": "error",
              "message_field": "message"
            },
            "evidence": [
              {
                "source_id": "users-response-dto",
                "locator": "UsersResponseApiDto"
              }
            ]
          },
          "evidence": [
            {
              "source_id": "users-api",
              "locator": "HttpClient.get<UsersResponseApiDto>"
            }
          ]
        }
      ],
      "evidence": [{ "source_id": "users-api", "locator": "UsersApi.readAll" }]
    }
