  "facts": [
    {
      "id": "fact.login.operation",
      "category": "operation",
      "statement": "Login is exposed as a public unauthenticated HTTP POST operation at login.",
      "evidence_refs": ["source.login-api", "source.authentication-endpoints"],
      "confidence": 1,
      "status": "observed"
    },
    {
      "id": "fact.login.input",
      "category": "data_shape",
      "statement": "Login accepts email and password values.",
      "evidence_refs": ["source.login-contract"],
      "confidence": 1,
      "status": "observed"
    },
    {
      "id": "fact.login.constraints",
      "category": "constraint",
      "statement": "Login requires email and password, and email must match the declared email format.",
      "evidence_refs": ["source.login-validator"],
      "confidence": 1,
      "status": "observed"
    },
    {
      "id": "fact.login.output",
      "category": "data_shape",
      "statement": "Login returns a user, an authentication token, and an optional message.",
      "evidence_refs": ["source.login-props"],
      "confidence": 1,
      "status": "observed"
    },
    {
      "id": "fact.login.session-effect",
