      "id": "processing.list-report-action-types",
      "service_id": "report-api",
      "status": "implemented",
      "description": "Loads the action types available for one report.",
      "method": "GET",
      "path": "/processing-actions/{id}/report-types",
      "access": {
        "mode": "authenticated",
        "security_scheme_ids": ["backoffice-session-bearer"],
        "permissions": []
      },
      "request": {
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Report unique identifier, encoded as one path segment.",
            "required": true,
            "type": { "kind": "primitive", "name": "string" },
            "constraints": { "min_length": 1 },
            "evidence": [
              {
                "source_id": "tasks-actions-processing-type-api",
                "locator": "/${dto.id}/report-types"
              },
              {
                "source_id": "tasks-actions-processing-type-filter-mapper",
                "locator": "id: contract.reportUniqId"
              }
            ]
          }
        ]
      },
      "responses": [
        {
          "status": 200,
          "outcome": "success",
          "description": "Report action types available.",
          "body": {
            "media_type": "application/json",
            "model_id": "tasks-actions-processing-type-list-wire",
            "envelope": {
              "kind": "object",
              "data_field": "data",
              "error_field": "error",
              "message_field": "message"
            },
            "evidence": [
