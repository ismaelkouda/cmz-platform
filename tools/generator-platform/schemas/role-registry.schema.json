{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cmz.local/schemas/generator-platform/role-registry.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "roles"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "kind": { "const": "archetype-role-registry" },
    "roles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "producer", "consumer", "description"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "producer": { "$ref": "#/$defs/id" },
          "consumer": { "$ref": "#/$defs/id" },
          "description": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" }
  }
}
