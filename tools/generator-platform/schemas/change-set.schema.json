{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cmz.local/schemas/generator-platform/change-set.schema.json",
  "title": "CMZ Generator Platform Change Set",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "change_set_id", "mode", "targets", "summary"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "change_set_id": { "$ref": "#/$defs/id" },
    "mode": { "const": "dry-run" },
    "control_plane": { "$ref": "#/$defs/change-group" },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "allOf": [
          { "$ref": "#/$defs/change-group" },
          {
            "type": "object",
            "required": ["id"],
            "properties": {
              "id": { "enum": ["angular", "reactjs"] }
            }
          }
        ]
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["create", "replace", "preserve", "delete", "unchanged"],
      "properties": {
        "create": { "type": "integer", "minimum": 0 },
        "replace": { "type": "integer", "minimum": 0 },
        "preserve": { "type": "integer", "minimum": 0 },
        "delete": { "type": "integer", "minimum": 0 },
        "unchanged": { "type": "integer", "minimum": 0 }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9:._-]*$" },
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "change-group": {
      "type": "object",
      "additionalProperties": false,
      "required": ["desired_manifest_sha256", "changes"],
      "properties": {
        "id": { "enum": ["angular", "reactjs"] },
        "previous_manifest_sha256": { "$ref": "#/$defs/hash" },
        "desired_manifest_sha256": { "$ref": "#/$defs/hash" },
        "changes": {
          "type": "array",
          "items": { "$ref": "#/$defs/change" }
        }
      }
    },
    "change": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "artifact_id", "owner", "action"],
      "properties": {
        "path": { "type": "string", "pattern": "^[a-z0-9][a-z0-9/._-]*$" },
        "artifact_id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "owner": {
          "enum": [
            "generator-owned",
            "human-owned",
            "configuration-owned",
            "external-owned"
          ]
        },
        "action": {
          "enum": ["create", "replace", "preserve", "delete", "unchanged"]
        },
        "before_sha256": { "$ref": "#/$defs/hash" },
        "after_sha256": { "$ref": "#/$defs/hash" }
      }
    }
  }
}
