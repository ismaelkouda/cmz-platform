{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cmz.local/schemas/generator-platform/generation-manifest.schema.json",
  "title": "CMZ Generator Platform Generation Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generator",
    "input",
    "plan",
    "target",
    "files",
    "tree_sha256"
  ],
  "properties": {
    "schema_version": { "const": "1.1.0" },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "const": "cmz-generator-platform" },
        "version": { "const": "1.2.0" }
      }
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plan_id", "sha256"],
      "properties": {
        "plan_id": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/hash" }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_id", "sha256"],
      "properties": {
        "model_id": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/hash" }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_id", "profile_version", "profile_sha256"],
      "properties": {
        "profile_id": {
          "enum": [
            "angular-nx",
            "react-typescript",
            "angular-nx-layered-domain",
            "angular-nx-layered-data",
            "angular-nx-layered-application",
            "react-typescript-layered-domain",
            "react-typescript-layered-data",
            "react-typescript-layered-application"
          ]
        },
        "profile_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "profile_sha256": { "$ref": "#/$defs/hash" }
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "artifact_id",
          "owner",
          "write_policy",
          "bytes",
          "sha256"
        ],
        "properties": {
          "path": { "type": "string", "pattern": "^[a-z0-9][a-z0-9/._-]*$" },
          "artifact_id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "owner": {
            "enum": [
              "generator-owned",
              "human-owned",
              "configuration-owned",
              "external-owned"
            ]
          },
          "write_policy": {
            "enum": ["create", "replace", "preserve", "delete"]
          },
          "bytes": { "type": "integer", "minimum": 1 },
          "sha256": { "$ref": "#/$defs/hash" }
        }
      }
    },
    "tree_sha256": { "$ref": "#/$defs/hash" }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
