{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cmz.local/schemas/generator-platform/composition-instance.schema.json",
  "title": "CMZ Generator Platform Persisted Composition Instance",
  "description": "A persisted, versioned, immutable snapshot of one evolved composition (ADR-0032, Option C). This is an instance record, never a promoted pattern: it carries no reusability contract, no invariants extraction and no catalog visibility. Promotion to a pattern is a separate, explicit act outside this schema.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "instance_id",
    "recorded_at",
    "source",
    "contract_ref",
    "projected_definition",
    "targets",
    "integrity"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "kind": { "const": "composition-instance" },
    "instance_id": { "$ref": "#/$defs/id" },
    "recorded_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["definition_uri", "definition_sha256"],
      "properties": {
        "definition_uri": { "type": "string", "minLength": 1 },
        "definition_sha256": { "$ref": "#/$defs/hash" }
      }
    },
    "contract_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_id"],
      "properties": {
        "contract_id": { "type": "string", "minLength": 1 }
      }
    },
    "projected_definition": {
      "description": "The exact action-request definition, after evolution projection, that produced this instance. Reloading replays this payload; it is never re-derived from the live contract at load time.",
      "type": "object"
    },
    "targets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["angular", "reactjs"],
      "properties": {
        "angular": { "$ref": "#/$defs/target_snapshot" },
        "reactjs": { "$ref": "#/$defs/target_snapshot" }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "envelope_sha256"],
      "properties": {
        "algorithm": { "const": "sha256-stable-json-v1" },
        "envelope_sha256": { "$ref": "#/$defs/hash" }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9:._-]*$" },
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "target_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_id",
        "manifest_tree_sha256",
        "manifest_input_sha256"
      ],
      "properties": {
        "profile_id": { "enum": ["angular-nx", "react-typescript"] },
        "manifest_tree_sha256": { "$ref": "#/$defs/hash" },
        "manifest_input_sha256": { "$ref": "#/$defs/hash" }
      }
    }
  }
}
