{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cmz.local/schemas/generator-platform/visual-evaluation-bundle.schema.json",
  "title": "CMZ Visual Evaluation Bundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "evaluation_id",
    "page_id",
    "presentation_id",
    "status",
    "review_protocol",
    "render_environment",
    "cases"
  ],
  "properties": {
    "schema_version": { "const": "2.0.0" },
    "kind": { "const": "visual-evaluation-bundle" },
    "evaluation_id": {
      "type": "string",
      "pattern": "^visual-evaluation_[a-f0-9]{16}$"
    },
    "page_id": { "type": "string", "pattern": "^page_[a-f0-9]{16}$" },
    "presentation_id": {
      "type": "string",
      "pattern": "^presentation_[a-f0-9]{16}$"
    },
    "status": { "const": "captured-unreviewed" },
    "review_protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol_id", "uri", "bytes", "sha256"],
      "properties": {
        "protocol_id": {
          "type": "string",
          "pattern": "^visual-review_[a-f0-9]{16}$"
        },
        "uri": { "type": "string", "minLength": 1 },
        "bytes": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "render_environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "os",
        "architecture",
        "playwright_version",
        "browser_name",
        "browser_version",
        "browser_channel",
        "locale",
        "timezone_id",
        "color_scheme",
        "reduced_motion"
      ],
      "properties": {
        "os": { "type": "string", "minLength": 1 },
        "architecture": { "type": "string", "minLength": 1 },
        "playwright_version": { "type": "string", "minLength": 1 },
        "browser_name": { "const": "chromium" },
        "browser_version": { "type": "string", "minLength": 1 },
        "browser_channel": { "type": "string", "minLength": 1 },
        "locale": { "const": "fr-FR" },
        "timezone_id": { "const": "Africa/Abidjan" },
        "color_scheme": { "const": "light" },
        "reduced_motion": { "const": "reduce" }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/resultCase" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
    },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uri", "bytes", "sha256", "width", "height"],
      "properties": {
        "uri": { "type": "string", "minLength": 1 },
        "bytes": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      }
    },
    "evidenceAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uri", "bytes", "sha256"],
      "properties": {
        "uri": { "type": "string", "minLength": 1 },
        "bytes": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "scalar": {
      "anyOf": [
        { "type": "string" },
        { "type": "number" },
        { "type": "boolean" },
        { "type": "null" }
      ]
    },
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "actual"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "actual": { "$ref": "#/$defs/scalar" },
        "expected": { "$ref": "#/$defs/scalar" }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["criterion_id", "outcome", "facts"],
      "properties": {
        "criterion_id": { "$ref": "#/$defs/id" },
        "outcome": { "enum": ["pass", "fail", "inconclusive"] },
        "facts": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/fact" }
        }
      }
    },
    "criterionReview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "dimension",
        "title",
        "question",
        "evidence_mode",
        "blocking",
        "source_refs",
        "deterministic_outcome",
        "human_outcome"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "dimension": {
          "enum": [
            "accessibility-semantics",
            "accessibility-feedback",
            "layout-geometry",
            "content-hierarchy",
            "feedback-legibility",
            "reference-fidelity"
          ]
        },
        "title": { "type": "string", "minLength": 1 },
        "question": { "type": "string", "minLength": 1 },
        "evidence_mode": {
          "enum": ["deterministic", "human", "hybrid"]
        },
        "blocking": { "type": "boolean" },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "deterministic_outcome": {
          "enum": ["pass", "fail", "inconclusive", "not-applicable"]
        },
        "human_outcome": { "enum": ["pending", "not-applicable"] }
      }
    },
    "resultCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "reference_source_id",
        "reference",
        "actual",
        "runtime_evidence",
        "runtime_scenario",
        "review"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "reference_source_id": { "$ref": "#/$defs/id" },
        "reference": { "$ref": "#/$defs/asset" },
        "actual": { "$ref": "#/$defs/asset" },
        "runtime_evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["asset", "findings"],
          "properties": {
            "asset": { "$ref": "#/$defs/evidenceAsset" },
            "findings": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/finding" }
            }
          }
        },
        "runtime_scenario": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "spec_uri",
            "test_title",
            "capture_name",
            "evidence_name"
          ],
          "properties": {
            "spec_uri": { "type": "string", "minLength": 1 },
            "test_title": { "type": "string", "minLength": 1 },
            "capture_name": { "type": "string", "minLength": 1 },
            "evidence_name": { "type": "string", "minLength": 1 }
          }
        },
        "review": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "authority", "criteria"],
          "properties": {
            "status": { "const": "pending-human-review" },
            "authority": { "const": "human" },
            "criteria": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/criterionReview" }
            }
          }
        }
      }
    }
  }
}
