{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cmz.local/schemas/generator-platform/visual-evaluation-bundle.schema.json",
  "title": "CMZ Visual Evaluation Bundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "evaluation_id",
    "page_id",
    "presentation_id",
    "status",
    "render_environment",
    "cases"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "kind": { "const": "visual-evaluation-bundle" },
    "evaluation_id": {
      "type": "string",
      "pattern": "^visual-evaluation_[a-f0-9]{16}$"
    },
    "page_id": { "type": "string", "pattern": "^page_[a-f0-9]{16}$" },
    "presentation_id": {
      "type": "string",
      "pattern": "^presentation_[a-f0-9]{16}$"
    },
    "status": { "const": "captured-unreviewed" },
    "render_environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "os",
        "architecture",
        "playwright_version",
        "browser_name",
        "browser_version",
        "browser_channel",
        "locale",
        "timezone_id",
        "color_scheme",
        "reduced_motion"
      ],
      "properties": {
        "os": { "type": "string", "minLength": 1 },
        "architecture": { "type": "string", "minLength": 1 },
        "playwright_version": { "type": "string", "minLength": 1 },
        "browser_name": { "const": "chromium" },
        "browser_version": { "type": "string", "minLength": 1 },
        "browser_channel": { "type": "string", "minLength": 1 },
        "locale": { "const": "fr-FR" },
        "timezone_id": { "const": "Africa/Abidjan" },
        "color_scheme": { "const": "light" },
        "reduced_motion": { "const": "reduce" }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/resultCase" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
    },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uri", "bytes", "sha256", "width", "height"],
      "properties": {
        "uri": { "type": "string", "minLength": 1 },
        "bytes": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      }
    },
    "resultCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "reference_source_id",
        "reference",
        "actual",
        "runtime_scenario",
        "review"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "reference_source_id": { "$ref": "#/$defs/id" },
        "reference": { "$ref": "#/$defs/asset" },
        "actual": { "$ref": "#/$defs/asset" },
        "runtime_scenario": {
          "type": "object",
          "additionalProperties": false,
          "required": ["spec_uri", "test_title", "capture_name"],
          "properties": {
            "spec_uri": { "type": "string", "minLength": 1 },
            "test_title": { "type": "string", "minLength": 1 },
            "capture_name": { "type": "string", "minLength": 1 }
          }
        },
        "review": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "authority", "dimensions"],
          "properties": {
            "status": { "const": "pending-human-review" },
            "authority": { "const": "human" },
            "dimensions": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  }
}
