{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cmz.local/schemas/generator-platform/archetype-contract.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["archetype", "role", "shape", "forbid"],
  "properties": {
    "archetype": { "$ref": "#/$defs/id" },
    "role": { "$ref": "#/$defs/id" },
    "shape": { "type": "string", "minLength": 1 },
    "forbid": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" }
  }
}
