{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cmz.local/schemas/generator-platform/list-query-definition.schema.json",
  "title": "CMZ List Query Authoring Definition (perimetre restreint: List simple)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "feature", "operations"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "kind": { "const": "list-query" },
    "feature": { "$ref": "#/$defs/feature" },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/operation" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
    },
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "feature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "description"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "$ref": "#/$defs/nonEmptyString" },
        "description": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "typeRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "name", "nullable"],
      "properties": {
        "kind": { "const": "primitive" },
        "name": { "$ref": "#/$defs/id" },
        "nullable": { "type": "boolean" }
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type", "required"],
      "properties": {
        "name": { "$ref": "#/$defs/id" },
        "type": { "$ref": "#/$defs/typeRef" },
        "required": { "type": "boolean" }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "fields"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "description": { "$ref": "#/$defs/nonEmptyString" },
        "fields": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/field" }
        }
      }
    },
    "access": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": { "enum": ["public", "authenticated"] }
      }
    },
    "http": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "path", "authentication"],
      "properties": {
        "method": { "const": "GET" },
        "path": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9/_{}-]*$"
        },
        "authentication": {
          "enum": ["none", "bearer", "session", "api_key", "other"]
        },
        "response_envelope": { "enum": ["none", "simple"] }
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "item", "access", "http"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "description": { "$ref": "#/$defs/nonEmptyString" },
        "item": { "$ref": "#/$defs/item" },
        "access": { "$ref": "#/$defs/access" },
        "http": { "$ref": "#/$defs/http" }
      }
    }
  }
}
