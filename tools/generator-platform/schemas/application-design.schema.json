          "properties": {
            "label_pointer": {
              "type": "string",
              "maxLength": 256,
              "pattern": "^(?:|/(?:[^~]|~[01])*)$"
            },
            "path_pointer": {
              "type": "string",
              "maxLength": 256,
              "pattern": "^(?:|/(?:[^~]|~[01])*)$"
            },
            "children_pointer": {
              "type": "string",
              "maxLength": 256,
              "pattern": "^(?:|/(?:[^~]|~[01])*)$"
            }
          }
        },
        "protected_operations": {
          "type": "array",
