              },
              "service_id": {
                "$ref": "#/$defs/id"
              },
              "operation_id": {
                "$ref": "#/$defs/id"
              },
              "method": {
                "enum": [
                  "GET",
                  "POST",
                  "PUT",
                  "PATCH",
                  "DELETE",
                  "HEAD",
                  "OPTIONS"
                ]
              },
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "security_scheme_id": {
                "$ref": "#/$defs/id"
              }
            }
          }
        }
      }
    },
    "experience11": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
