{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cmz.local/schemas/generator-platform/presentation-layout-binding.schema.json",
  "title": "CMZ Presentation Layout Binding",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "binding_id",
    "page_id",
    "page_contract_sha256",
    "authority",
    "example_sets",
    "capabilities",
    "selections"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "kind": { "const": "presentation-layout-binding" },
    "binding_id": { "$ref": "#/$defs/id" },
    "page_id": { "type": "string", "pattern": "^page_[a-f0-9]{16}$" },
    "page_contract_sha256": { "$ref": "#/$defs/sha256" },
    "authority": { "const": "layout-guidance-only" },
    "example_sets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": { "$ref": "#/$defs/exampleSet" }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/declaredCapability" },
          { "$ref": "#/$defs/absentCapability" }
        ]
      }
    },
    "selections": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": { "$ref": "#/$defs/selection" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
    },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "capabilityId": {
      "enum": [
        "search",
        "create",
        "refresh",
        "export",
        "column-filters",
        "filter-trigger",
        "filter-panel",
        "row-actions",
        "row-rank",
        "card-actions",
        "progressive-loading",
        "create-fab",
        "workspace-tabs",
        "individual-tab-close",
        "close-all-except-pinned",
        "horizontal-tab-overflow"
      ]
    },
    "regionId": {
      "enum": [
        "table-toolbar",
        "data-grid",
        "filter-panel",
        "row-actions-rail",
        "horizontal-scroll-rail",
        "collection-header",
        "search-controls",
        "card-list",
        "bottom-sheet",
        "modal-backdrop",
        "floating-action",
        "workspace-navigation-strip"
      ]
    },
    "exampleSet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["set_id", "path", "sha256"],
      "properties": {
        "set_id": { "$ref": "#/$defs/id" },
        "path": {
          "type": "string",
          "pattern": "^examples/presentation/[a-z0-9-]+-layout-examples/example-set\\.json$"
        },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "declaredCapability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "authorized_by"],
      "properties": {
        "id": { "$ref": "#/$defs/capabilityId" },
        "status": { "const": "declared" },
        "authorized_by": {
          "oneOf": [
            { "$ref": "#/$defs/backendParameterAuthority" },
            { "$ref": "#/$defs/pageActionAuthority" },
            { "$ref": "#/$defs/pageLoadAuthority" }
          ]
        }
      }
    },
    "absentCapability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "reason"],
      "properties": {
        "id": { "$ref": "#/$defs/capabilityId" },
        "status": { "const": "absent" },
        "reason": { "const": "no-contract-capability" }
      }
    },
    "backendParameterAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "contract_id", "operation_id", "parameters"],
      "properties": {
        "kind": { "const": "backend-parameter" },
        "contract_id": { "$ref": "#/$defs/id" },
        "operation_id": { "$ref": "#/$defs/id" },
        "parameters": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
          }
        }
      }
    },
    "pageActionAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "action_id"],
      "properties": {
        "kind": { "const": "page-action" },
        "action_id": { "$ref": "#/$defs/id" }
      }
    },
    "pageLoadAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "load_id"],
      "properties": {
        "kind": { "const": "page-load" },
        "load_id": { "$ref": "#/$defs/id" }
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "set_id",
        "source_id",
        "page_state_ids",
        "regions",
        "omitted_capabilities"
      ],
      "properties": {
        "set_id": { "$ref": "#/$defs/id" },
        "source_id": { "$ref": "#/$defs/id" },
        "page_state_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "regions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/regionId" }
        },
        "omitted_capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/capabilityId" }
        }
      }
    }
  }
}
