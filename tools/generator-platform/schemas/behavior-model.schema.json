{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cmz.example/schemas/behavior-model.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "domain",
    "state",
    "permissions",
    "operations"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "domain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "description": { "type": "string", "minLength": 1 }
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["statuses", "qualification_statuses"],
      "properties": {
        "statuses": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "qualification_statuses": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" },
          "uniqueItems": true
        }
      }
    },
    "permissions": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "topology",
          "permission",
          "from",
          "to",
          "branches",
          "rules",
          "steps"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["transition", "export"] },
          "topology": { "enum": ["sequential", "async_callback"] },
          "permission": { "type": "string", "minLength": 1 },
          "from": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          },
          "to": { "type": "string", "minLength": 1 },
          "branches": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "when",
                "permission",
                "qualification_from",
                "qualification_to",
                "to"
              ],
              "properties": {
                "when": { "type": "string", "minLength": 1 },
                "permission": { "type": "string", "minLength": 1 },
                "qualification_from": { "type": "string" },
                "qualification_to": { "type": "string" },
                "to": { "type": "string", "minLength": 1 }
              }
            }
          },
          "rules": {
            "type": "array",
            "items": {
              "enum": [
                "rejected_requires_reason_comment",
                "callback_requires_type",
                "edit_or_callback_requires_comment_and_fields",
                "not_loading",
                "not_exporting",
                "positive_total",
                "no_rows_no_write",
                "errors_notified"
              ]
            },
            "uniqueItems": true
          },
          "steps": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          }
        }
      }
    }
  }
}
