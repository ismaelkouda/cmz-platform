{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cmz.local/schemas/generator-platform/visual-runtime-evidence.schema.json",
  "title": "CMZ Visual Runtime Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "case_id", "viewport", "findings"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "kind": { "const": "visual-runtime-evidence" },
    "case_id": { "$ref": "#/$defs/id" },
    "viewport": { "$ref": "#/$defs/viewport" },
    "findings": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/finding" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
    },
    "viewport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height", "pixel_ratio"],
      "properties": {
        "width": { "type": "integer", "minimum": 1, "maximum": 8192 },
        "height": { "type": "integer", "minimum": 1, "maximum": 16384 },
        "pixel_ratio": { "const": 1 }
      }
    },
    "scalar": {
      "anyOf": [
        { "type": "string" },
        { "type": "number" },
        { "type": "boolean" },
        { "type": "null" }
      ]
    },
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "actual"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "actual": { "$ref": "#/$defs/scalar" },
        "expected": { "$ref": "#/$defs/scalar" }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["criterion_id", "outcome", "facts"],
      "properties": {
        "criterion_id": { "$ref": "#/$defs/id" },
        "outcome": { "enum": ["pass", "fail", "inconclusive"] },
        "facts": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/fact" }
        }
      }
    }
  }
}
