{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cmz.local/schemas/generator-platform/visual-evaluation-plan.schema.json",
  "title": "CMZ Visual Evaluation Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "evaluation_id",
    "page_id",
    "presentation_id",
    "presentation_evidence_uri",
    "cases"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "kind": { "const": "visual-evaluation-plan" },
    "evaluation_id": {
      "type": "string",
      "pattern": "^visual-evaluation_[a-f0-9]{16}$"
    },
    "page_id": { "type": "string", "pattern": "^page_[a-f0-9]{16}$" },
    "presentation_id": {
      "type": "string",
      "pattern": "^presentation_[a-f0-9]{16}$"
    },
    "presentation_evidence_uri": { "$ref": "#/$defs/workspacePath" },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/evaluationCase" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
    },
    "workspacePath": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._/-]+$"
    },
    "viewport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height", "pixel_ratio"],
      "properties": {
        "width": { "type": "integer", "minimum": 1, "maximum": 8192 },
        "height": { "type": "integer", "minimum": 1, "maximum": 16384 },
        "pixel_ratio": { "const": 1 }
      }
    },
    "evaluationCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "reference_source_id",
        "viewport",
        "runtime_scenario",
        "review_dimensions"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "reference_source_id": { "$ref": "#/$defs/id" },
        "viewport": { "$ref": "#/$defs/viewport" },
        "runtime_scenario": {
          "type": "object",
          "additionalProperties": false,
          "required": ["spec_uri", "test_title", "capture_name"],
          "properties": {
            "spec_uri": { "$ref": "#/$defs/workspacePath" },
            "test_title": { "type": "string", "minLength": 1 },
            "capture_name": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*\\.actual\\.png$"
            }
          }
        },
        "review_dimensions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "content-hierarchy",
              "feedback-state",
              "layout-geometry",
              "responsive-placement",
              "visual-styling"
            ]
          }
        }
      }
    }
  }
}
